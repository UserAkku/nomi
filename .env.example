# Copy to .env and fill in. Never commit .env.

# Local model served by Ollama (https://ollama.com)
NOMI_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_HOST=http://localhost:11434

# Optional: GitHub token for higher API rate limits (read-only scope is enough for `nomi analyze`)
GITHUB_TOKEN=

# GitHub App server (`nomi serve`)
NOMI_APP_ID=
NOMI_APP_PRIVATE_KEY_PATH=./nomi.private-key.pem
NOMI_WEBHOOK_SECRET=
# Keep true until you have installed the app on a repository you own.
NOMI_DRY_RUN=true
